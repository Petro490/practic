--Задача 2
--Задание 2.1
SELECT 
    host_id, 
    COUNT(*) AS listings_count, 
    AVG(price) AS avg_price
FROM listings
GROUP BY host_id

--Задание 2.2
SELECT *
FROM hosts h
JOIN (
    SELECT 
        host_id, 
        COUNT(*) AS listings_count, 
        AVG(price) AS avg_price
FROM listings
GROUP BY host_id
) l ON h.id = l.host_id

--Задание 2.3
SELECT 
    id AS host_id,
    host_since AS registration_date,
    name as name_host,
    l.listings_count,
    l.avg_price
FROM hosts h
JOIN (
    SELECT 
        host_id, 
        COUNT(*) AS listings_count, 
        AVG(price) AS avg_price
    FROM listings
    GROUP BY host_id
) l ON h.id = l.host_id

